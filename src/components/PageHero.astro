---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  image: string;
  short?: boolean;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, accent, image, short = false, crumbs = [] } = Astro.props;
---
<section class:list={["relative flex items-end overflow-hidden", short ? "h-[50vh] min-h-[350px]" : "h-[60vh] min-h-[400px]"]}>
  <div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-dark/50 to-dark z-10"></div>
  <div class="absolute inset-0 bg-cover bg-center lg:bg-fixed" style={`background-image:url('${image}')`}></div>
  <div class="relative z-20 px-6 lg:px-12 pb-16 max-w-7xl mx-auto w-full">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 reveal">
        <ol class="flex flex-wrap items-center gap-2 text-xs tracking-[0.2em] uppercase text-muted-text">
          {crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <a href={c.href} class="hover:text-brand transition-colors">{c.label}</a>
              <span aria-hidden="true" class="text-brand/50">/</span>
            </li>
          ))}
          <li aria-current="page" class="text-light-text/80">{accent ? `${title} ${accent}` : title}</li>
        </ol>
      </nav>
    )}
    <span class="text-brand text-xs tracking-[0.3em] uppercase reveal">{eyebrow}</span>
    <h1 class="font-heading text-4xl sm:text-5xl lg:text-7xl mt-4 reveal" style="transition-delay:0.2s">
      {title} {accent && <span class="text-brand italic">{accent}</span>}
    </h1>
  </div>
</section>
