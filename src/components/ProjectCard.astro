---
import type { Project } from '../data/portfolio';
import { categoryLabels } from '../data/services';
interface Props { project: Project; aspect?: string }
const { project, aspect = 'aspect-[4/5]' } = Astro.props;
---
<a href={`/portfolio/${project.slug}`} class:list={["portfolio-item group relative img-zoom block focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-2", aspect]} data-category={project.category}>
  <img src={project.cover} alt={project.title} class="w-full h-full object-cover" loading="lazy" />
  <div class="absolute inset-0 bg-gradient-to-t from-dark/90 via-dark/10 to-transparent lg:opacity-0 lg:group-hover:opacity-100 lg:group-focus-visible:opacity-100 transition-opacity duration-500"></div>
  <div class="absolute bottom-0 left-0 right-0 p-6 lg:translate-y-4 lg:opacity-0 lg:group-hover:translate-y-0 lg:group-hover:opacity-100 lg:group-focus-visible:translate-y-0 lg:group-focus-visible:opacity-100 transition-all duration-500">
    <span class="text-brand text-xs tracking-[0.2em] uppercase">{categoryLabels[project.category]}</span>
    <h3 class="font-heading text-lg mt-1">{project.title}</h3>
    <p class="text-muted-text text-xs mt-1">{project.summary}</p>
  </div>
  {project.instagram.length > 0 && (
    <span class="absolute top-4 left-4 px-2 py-1 bg-dark/70 backdrop-blur-sm text-[10px] tracking-[0.2em] uppercase text-brand">{project.instagram.length} post{project.instagram.length > 1 ? 's' : ''}</span>
  )}
</a>
