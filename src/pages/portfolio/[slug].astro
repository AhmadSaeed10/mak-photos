---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gallery from '../../components/Gallery.astro';
import InstagramEmbeds from '../../components/InstagramEmbeds.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/portfolio';
import { categoryLabels, serviceForCategory } from '../../data/services';
import { site } from '../../data/site';

// Rendered on request: resolve the project from the URL.
const project = projects.find((p) => p.slug === Astro.params.slug);
if (!project) return Astro.rewrite('/404');
const service = serviceForCategory(project.category);
const idx = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];
const related = projects.filter((p) => p.category === project.category && p.slug !== project.slug).slice(0, 3);
const hasPosts = project.instagram.length > 0;
const hero = project.gallery[0] ?? project.cover;
const facts = [
  { label: 'Category', value: categoryLabels[project.category] },
  { label: 'Location', value: project.location },
  { label: 'Coverage', value: project.coverage },
];
---
<Layout title={`${project.title} | MAK Photos Portfolio`} description={`${project.title}: ${project.summary}. ${project.story}`}>
  <PageHero
    eyebrow={categoryLabels[project.category]}
    title={project.title}
    image={hero.replace(/w=\d+/, 'w=1920')}
    crumbs={[{ href: '/', label: 'Home' }, { href: '/portfolio', label: 'Portfolio' }]}
  />

  <section class="py-20 lg:py-28 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
      <div class="lg:col-span-7 reveal-left">
        <span class="text-brand text-xs tracking-[0.3em] uppercase">The Story</span>
        <p class="font-heading text-2xl lg:text-3xl leading-relaxed mt-4">{project.story}</p>
      </div>
      <dl class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-px bg-dark-border border border-dark-border reveal-right">
        {facts.map((f) => (
          <div class="bg-dark p-6">
            <dt class="text-xs tracking-[0.2em] uppercase text-brand">{f.label}</dt>
            <dd class="mt-2 text-light-text">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="pb-24 lg:pb-32 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto">
      {hasPosts ? (
        <InstagramEmbeds urls={project.instagram} />
      ) : (
        <Gallery id={project.slug} images={project.gallery.map((src, i) => ({ src, alt: `${project.title}, photo ${i + 1}` }))} />
      )}
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={site.instagramUrl} target="_blank" rel="noopener" class="px-8 py-4 border border-dark-border text-muted-text text-xs tracking-[0.2em] uppercase hover:border-brand hover:text-brand transition-all duration-300">More on Instagram</a>
        {service && (
          <a href={`/services/${service.slug}`} class="px-8 py-4 border border-brand text-brand text-xs tracking-[0.2em] uppercase hover:bg-brand hover:text-dark transition-all duration-300">About {service.shortTitle}</a>
        )}
      </div>
    </div>
  </section>

  <!-- Prev / next -->
  <nav aria-label="More projects" class="border-y border-dark-border grid grid-cols-2">
    <a href={`/portfolio/${prev.slug}`} class="group p-8 lg:p-12 border-r border-dark-border hover:bg-dark-card transition-colors">
      <span class="text-xs tracking-[0.2em] uppercase text-muted-text">&larr; Previous</span>
      <span class="block font-heading text-lg lg:text-2xl mt-2 group-hover:text-brand transition-colors">{prev.title}</span>
    </a>
    <a href={`/portfolio/${next.slug}`} class="group p-8 lg:p-12 text-right hover:bg-dark-card transition-colors">
      <span class="text-xs tracking-[0.2em] uppercase text-muted-text">Next &rarr;</span>
      <span class="block font-heading text-lg lg:text-2xl mt-2 group-hover:text-brand transition-colors">{next.title}</span>
    </a>
  </nav>

  {related.length > 0 && (
    <section class="py-24 px-6 lg:px-12 bg-dark-card">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-end justify-between mb-10">
          <h2 class="font-heading text-3xl">More {categoryLabels[project.category].toLowerCase()} work</h2>
          <a href={`/portfolio?category=${project.category}`} class="text-brand text-xs tracking-[0.2em] uppercase hover:underline underline-offset-8">View all</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {related.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand title="Want something" accent="similar?" message={`Hi MAK Photos, I saw "${project.title}" on your site and would like something similar.`} />
</Layout>
