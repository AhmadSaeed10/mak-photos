---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio | MAK Photos - Selected Work">

  <!-- PAGE HERO -->
  <section class="relative h-[60vh] min-h-[400px] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-dark/50 to-dark z-10"></div>
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1554048612-b6a482bc67e5?w=1920&q=80')] bg-cover bg-center bg-fixed"></div>
    <div class="relative z-20 px-6 lg:px-12 pb-16 max-w-7xl mx-auto w-full">
      <span class="text-brand text-xs tracking-[0.3em] uppercase reveal">Selected Work</span>
      <h1 class="font-heading text-5xl lg:text-7xl mt-4 reveal" style="transition-delay:0.2s">
        Our <span class="text-brand italic">Portfolio</span>
      </h1>
    </div>
  </section>

  <!-- FILTER TABS -->
  <section class="py-12 px-6 lg:px-12 border-b border-dark-border sticky top-[72px] bg-dark/95 backdrop-blur-md z-20">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-center gap-3">
      {["All", "Wedding", "Fashion", "Heritage", "Portrait", "Event", "Video"].map(cat => (
        <button
          class={`portfolio-filter px-6 py-2 text-xs tracking-[0.2em] uppercase border transition-all duration-300 ${cat === 'All' ? 'bg-brand text-dark border-brand active' : 'border-dark-border text-muted-text hover:border-brand hover:text-brand'}`}
          data-filter={cat.toLowerCase()}
        >
          {cat}
        </button>
      ))}
    </div>
  </section>

  <!-- PORTFOLIO GRID -->
  <section class="py-16 lg:py-24 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="portfolio-grid">
        {[
          { src: "https://images.unsplash.com/photo-1519741497674-611481863552?w=600&q=80", cat: "wedding", title: "Naina's Grand Celebration", desc: "Full wedding coverage" },
          { src: "https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=600&q=80", cat: "fashion", title: "Editorial Fashion Shoot", desc: "High-end fashion photography" },
          { src: "https://images.unsplash.com/photo-1587474260584-136574528ed5?w=600&q=80", cat: "heritage", title: "Lahore Fort at Sunset", desc: "Heritage documentation" },
          { src: "https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=600&q=80", cat: "wedding", title: "Bunny & Sahar Wedding", desc: "Mehndi to Walima coverage" },
          { src: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600&q=80", cat: "portrait", title: "Creative Portrait Series", desc: "Studio portrait session" },
          { src: "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&q=80", cat: "event", title: "Corporate Gala Night", desc: "Full event documentation" },
          { src: "https://images.unsplash.com/photo-1570168007204-dfb528c6958f?w=600&q=80", cat: "heritage", title: "Shalamar Bagh Gardens", desc: "Mughal heritage series" },
          { src: "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=600&q=80", cat: "wedding", title: "Mehak & Ghilman", desc: "Intimate ceremony coverage" },
          { src: "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=600&q=80", cat: "fashion", title: "Street Style Editorial", desc: "Urban fashion photography" },
          { src: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&q=80", cat: "portrait", title: "Professional Headshots", desc: "Corporate portrait session" },
          { src: "https://images.unsplash.com/photo-1548013146-72479768bada?w=600&q=80", cat: "heritage", title: "Walled City Streets", desc: "Living heritage of Lahore" },
          { src: "https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=600&q=80", cat: "video", title: "Cinematic Wedding Film", desc: "Wedding highlight reel" },
          { src: "https://images.unsplash.com/photo-1460978812857-470ed1c77af0?w=600&q=80", cat: "event", title: "Ali Zafar Live Concert", desc: "Celebrity event coverage" },
          { src: "https://images.unsplash.com/photo-1529636798458-92182e662485?w=600&q=80", cat: "fashion", title: "Bridal Couture Week", desc: "Fashion week coverage" },
          { src: "https://images.unsplash.com/photo-1519741497674-611481863552?w=600&q=80", cat: "wedding", title: "Gul E Hina's Walima", desc: "Grand reception photography" },
          { src: "https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=600&q=80", cat: "portrait", title: "Environmental Portrait", desc: "On-location creative portrait" },
          { src: "https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=600&q=80", cat: "video", title: "Brand Promotional Film", desc: "Commercial videography" },
          { src: "https://images.unsplash.com/photo-1505373877841-8d25f7d46678?w=600&q=80", cat: "event", title: "Product Launch Event", desc: "Corporate event documentation" },
        ].map(item => (
          <div class="portfolio-item group relative img-zoom aspect-[4/5] cursor-pointer" data-category={item.cat}>
            <img src={item.src} alt={item.title} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
              <span class="text-brand text-xs tracking-[0.2em] uppercase">{item.cat}</span>
              <h3 class="font-heading text-lg mt-1">{item.title}</h3>
              <p class="text-muted-text text-xs mt-1">{item.desc}</p>
            </div>
            <!-- Lightbox trigger icon -->
            <div class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center bg-dark/60 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div id="lightbox" class="lightbox">
    <button id="lightbox-close" class="absolute top-6 right-6 z-50 text-light-text hover:text-brand transition-colors">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[90vh] object-contain" />
  </div>

  <!-- CTA -->
  <section class="py-24 lg:py-32 px-6 lg:px-12 bg-dark-card text-center">
    <div class="max-w-3xl mx-auto reveal">
      <span class="text-brand text-xs tracking-[0.3em] uppercase">Like What You See?</span>
      <h2 class="font-heading text-4xl lg:text-5xl mt-4 mb-6">Let's Create Your <span class="text-brand italic">Vision</span></h2>
      <p class="text-muted-text mb-10">Every project in this portfolio started with a conversation. Ready to start yours?</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="group px-10 py-5 bg-brand text-dark text-sm tracking-[0.15em] uppercase font-medium hover:bg-brand-light transition-all duration-500 flex items-center gap-3">
          Start a Project
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="https://www.instagram.com/_makphotos/" target="_blank" rel="noopener" class="px-10 py-5 border border-light-text/30 text-light-text text-sm tracking-[0.15em] uppercase hover:border-brand hover:text-brand transition-all duration-500">
          Follow on Instagram
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Portfolio filter functionality
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelectorAll('.portfolio-filter');
    const items = document.querySelectorAll('.portfolio-item');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active state
        filters.forEach(f => {
          f.classList.remove('bg-brand', 'text-dark', 'border-brand', 'active');
          f.classList.add('border-dark-border', 'text-muted-text');
        });
        btn.classList.add('bg-brand', 'text-dark', 'border-brand', 'active');
        btn.classList.remove('border-dark-border', 'text-muted-text');

        // Filter items
        items.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            item.style.display = '';
            item.style.animation = 'fadeIn 0.5s ease forwards';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // Lightbox
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');

    items.forEach(item => {
      item.addEventListener('click', () => {
        const img = item.querySelector('img') as HTMLImageElement;
        if (img && lightboxImg && lightbox) {
          lightboxImg.src = img.src.replace('w=600', 'w=1400');
          lightboxImg.alt = img.alt;
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    lightboxClose?.addEventListener('click', () => {
      lightbox?.classList.remove('active');
      document.body.style.overflow = '';
    });

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox?.classList.contains('active')) {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
