---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { services } from '../data/services';
import { projects } from '../data/portfolio';
const featured = projects.filter((p) => p.featured).slice(0, 6);
---

<Layout title="MAK Photos | Professional Photography & Videography in Lahore">

  <!-- HERO SECTION -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden">
    <!-- Background with overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-dark/40 via-dark/60 to-dark z-10"></div>
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=1920&q=80')] bg-cover bg-center bg-fixed"></div>

    <!-- Animated grain overlay -->
    <div class="absolute inset-0 opacity-[0.03] z-10" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E');"></div>

    <!-- Hero Content -->
    <div class="relative z-20 text-center px-6 max-w-5xl">
      <div class="reveal" style="transition-delay: 0.5s">
        <span class="inline-block text-brand text-xs tracking-[0.4em] uppercase mb-6 border border-brand/30 px-4 py-2">
          Photography & Videography
        </span>
      </div>

      <h1 class="font-heading text-5xl md:text-7xl lg:text-8xl xl:text-9xl font-medium leading-[0.95] mb-8">
        <span class="block reveal" style="transition-delay: 0.7s">We Capture</span>
        <span class="block text-brand italic reveal" style="transition-delay: 0.9s">Moments</span>
        <span class="block reveal" style="transition-delay: 1.1s">That Last</span>
      </h1>

      <p class="text-muted-text text-base md:text-lg max-w-xl mx-auto mb-10 reveal" style="transition-delay: 1.3s">
        From grand weddings to intimate portraits, Moazzam Ali Khokhar brings stories to life through his lens. Based in the heart of Lahore.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 reveal" style="transition-delay: 1.5s">
        <a href="/portfolio" class="group px-8 py-4 bg-brand text-dark text-sm tracking-[0.15em] uppercase font-medium hover:bg-brand-light transition-all duration-500 flex items-center gap-3">
          View Portfolio
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/contact" class="px-8 py-4 border border-light-text/30 text-light-text text-sm tracking-[0.15em] uppercase hover:border-brand hover:text-brand transition-all duration-500">
          Book a Session
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 reveal" style="transition-delay: 2s">
      <span class="text-muted-text text-[10px] tracking-[0.3em] uppercase">Scroll</span>
      <div class="w-px h-12 bg-gradient-to-b from-brand to-transparent animate-pulse"></div>
    </div>

    <!-- Side social links -->
    <div class="hidden lg:flex fixed left-8 bottom-0 z-30 flex-col items-center gap-4">
      <a href="https://www.instagram.com/_makphotos/" target="_blank" rel="noopener" class="text-muted-text hover:text-brand transition-colors text-xs tracking-widest [writing-mode:vertical-lr]">Instagram</a>
      <div class="w-px h-20 bg-brand/30"></div>
    </div>
  </section>

  <!-- INTRO / ABOUT PREVIEW -->
  <section class="py-24 lg:py-40 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <!-- Left: Image -->
        <div class="reveal-left">
          <div class="relative">
            <div class="img-zoom aspect-[3/4] overflow-hidden">
              <img src="https://images.unsplash.com/photo-1554048612-b6a482bc67e5?w=800&q=80" alt="Moazzam Ali Khokhar - Photographer" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <!-- Floating accent -->
            <div class="absolute -bottom-6 -right-6 w-48 h-48 border border-brand/20"></div>
            <div class="absolute -top-6 -left-6 w-24 h-24 bg-brand/10"></div>

            <!-- Experience badge -->
            <div class="absolute bottom-8 right-8 bg-dark-card/90 backdrop-blur-sm px-6 py-4 border border-dark-border">
              <span class="font-heading text-3xl text-brand">5+</span>
              <span class="block text-xs text-muted-text tracking-wider uppercase mt-1">Years of Passion</span>
            </div>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="reveal-right">
          <span class="text-brand text-xs tracking-[0.3em] uppercase">The Artist Behind The Lens</span>
          <h2 class="font-heading text-4xl lg:text-5xl mt-4 mb-8 leading-tight">
            Moazzam Ali<br/><span class="text-brand italic">Khokhar</span>
          </h2>
          <div class="space-y-5 text-muted-text leading-relaxed">
            <p>
              A passionate visual storyteller based in Lahore, Moazzam Ali Khokhar lives and breathes photography. As the official photographer at the <strong class="text-light-text">Walled City of Lahore Authority</strong>, he has had the privilege of documenting some of Pakistan's most treasured heritage sites.
            </p>
            <p>
              From the grandeur of the Lahore Fort to the intimate celebrations of a wedding day, his lens captures emotion, culture, and artistry in every frame. As a Graphics Designer, Visualizer, Photo Journalist, Fashion Photographer, and Wedding Photographer, Moazzam brings a rare versatility to every project.
            </p>
          </div>

          <div class="flex gap-8 mt-10 mb-10">
            <div>
              <span class="font-heading text-3xl text-brand counter" data-target="1172" data-suffix="+">0</span>
              <span class="block text-xs text-muted-text tracking-wider uppercase mt-1">Instagram Followers</span>
            </div>
            <div>
              <span class="font-heading text-3xl text-brand counter" data-target="500" data-suffix="+">0</span>
              <span class="block text-xs text-muted-text tracking-wider uppercase mt-1">Projects Delivered</span>
            </div>
            <div>
              <span class="font-heading text-3xl text-brand counter" data-target="200" data-suffix="+">0</span>
              <span class="block text-xs text-muted-text tracking-wider uppercase mt-1">Happy Clients</span>
            </div>
          </div>

          <a href="/about" class="group inline-flex items-center gap-3 text-brand text-sm tracking-[0.15em] uppercase hover:gap-5 transition-all duration-500">
            Read Full Story
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE STRIP -->
  <section class="py-8 border-y border-dark-border overflow-hidden">
    <div class="marquee-track">
      {Array(2).fill(null).map(() => (
        <div class="flex items-center gap-8 px-4">
          {['Wedding Photography', 'Fashion Shoots', 'Photo Journalism', 'Event Coverage', 'Heritage Documentation', 'Portrait Sessions', 'Cinematic Videos', 'Brand Visuals'].map(item => (
            <span class="font-heading text-2xl lg:text-3xl text-light-text/10 whitespace-nowrap flex items-center gap-8">
              {item}
              <span class="w-2 h-2 rounded-full bg-brand/40"></span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES OVERVIEW -->
  <section class="py-24 lg:py-40 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-20 reveal">
        <span class="text-brand text-xs tracking-[0.3em] uppercase">What We Offer</span>
        <h2 class="font-heading text-4xl lg:text-6xl mt-4">Our <span class="text-brand italic">Services</span></h2>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {services.map(service => (
          <a href={`/services/${service.slug}`} class="group block p-8 lg:p-10 bg-dark-card border border-dark-border hover:border-brand/40 focus-visible:border-brand transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-6 right-6 font-heading text-6xl text-dark-border/50 group-hover:text-brand/10 transition-colors duration-500">{service.num}</div>
            <div class="text-brand mb-6 group-hover:scale-110 transition-transform duration-500" set:html={service.icon} />
            <h3 class="font-heading text-xl mb-4 group-hover:text-brand transition-colors duration-300">{service.shortTitle}</h3>
            <p class="text-sm text-muted-text leading-relaxed">{service.summary}</p>
            <div class="mt-6 flex items-center gap-2 text-brand text-xs tracking-widest uppercase lg:opacity-0 lg:group-hover:opacity-100 lg:group-focus-visible:opacity-100 transition-opacity duration-500">
              <span>Learn More</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a href="/services" class="group inline-flex items-center gap-3 px-8 py-4 border border-brand text-brand text-sm tracking-[0.15em] uppercase hover:bg-brand hover:text-dark transition-all duration-500">
          All Services
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO PREVIEW -->
  <section class="py-24 lg:py-40 bg-dark-card">
    <div class="px-6 lg:px-12">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between mb-16">
          <div class="reveal">
            <span class="text-brand text-xs tracking-[0.3em] uppercase">Selected Work</span>
            <h2 class="font-heading text-4xl lg:text-6xl mt-4">Featured <span class="text-brand italic">Portfolio</span></h2>
          </div>
          <a href="/portfolio" class="group mt-6 lg:mt-0 inline-flex items-center gap-3 text-brand text-sm tracking-[0.15em] uppercase hover:gap-5 transition-all duration-500 reveal">
            View All Work
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Portfolio Grid -->
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 stagger-children">
        {featured.map(p => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-24 lg:py-40 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20 reveal">
        <span class="text-brand text-xs tracking-[0.3em] uppercase">Client Love</span>
        <h2 class="font-heading text-4xl lg:text-6xl mt-4">What They <span class="text-brand italic">Say</span></h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {[
          {
            quote: "Moazzam captured our wedding day with such artistry and emotion. Every photo tells a story, and we couldn't be happier with the results. His attention to detail is truly remarkable.",
            name: "Sahar & Bunny",
            event: "Wedding Photography"
          },
          {
            quote: "Working with MAK Photos for our fashion lookbook was an incredible experience. He understood the vision perfectly and brought it to life with stunning creativity and professionalism.",
            name: "Naina Ahmed",
            event: "Fashion Shoot"
          },
          {
            quote: "The cinematic quality of our wedding film was beyond anything we imagined. Moazzam's ability to capture candid moments while maintaining a cinematic feel is unmatched in Lahore.",
            name: "Ali & Hina",
            event: "Wedding Videography"
          }
        ].map(testimonial => (
          <div class="p-8 lg:p-10 bg-dark-card border border-dark-border relative">
            <svg class="w-10 h-10 text-brand/20 mb-6" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z"/></svg>
            <p class="text-muted-text text-sm leading-relaxed mb-8">{testimonial.quote}</p>
            <div class="border-t border-dark-border pt-6">
              <span class="text-light-text font-medium">{testimonial.name}</span>
              <span class="block text-brand text-xs tracking-wider uppercase mt-1">{testimonial.event}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="relative py-32 lg:py-48 overflow-hidden">
    <div class="parallax-container absolute inset-0">
      <div class="parallax-bg bg-[url('https://images.unsplash.com/photo-1537633552985-df8429e8048b?w=1920&q=80')] bg-cover bg-center" data-speed="0.3"></div>
    </div>
    <div class="absolute inset-0 bg-dark/80"></div>
    <div class="relative z-10 text-center px-6">
      <div class="max-w-3xl mx-auto">
        <span class="text-brand text-xs tracking-[0.3em] uppercase reveal">Ready to Create Something Beautiful?</span>
        <h2 class="font-heading text-4xl md:text-6xl lg:text-7xl mt-6 mb-8 reveal" style="transition-delay: 0.2s">
          Let's Tell Your <span class="text-brand italic">Story</span> Together
        </h2>
        <p class="text-muted-text text-lg mb-10 reveal" style="transition-delay: 0.4s">
          Every great image starts with a conversation. Whether it's your wedding, a fashion project, or a personal portrait, let's create memories that will last a lifetime.
        </p>
        <div class="reveal" style="transition-delay: 0.6s">
          <a href="/contact" class="group inline-flex items-center gap-3 px-10 py-5 bg-brand text-dark text-sm tracking-[0.15em] uppercase font-medium hover:bg-brand-light transition-all duration-500">
            Get In Touch
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- INSTAGRAM FEED CTA -->
  <section class="py-16 px-6 lg:px-12 border-t border-dark-border">
    <div class="max-w-7xl mx-auto text-center">
      <span class="text-brand text-xs tracking-[0.3em] uppercase reveal">Follow The Journey</span>
      <h3 class="font-heading text-2xl lg:text-3xl mt-4 mb-6 reveal">
        <a href="https://www.instagram.com/_makphotos/" target="_blank" rel="noopener" class="hover:text-brand transition-colors duration-300">
          @_makphotos
        </a>
      </h3>
      <p class="text-muted-text text-sm reveal">Follow us on Instagram for daily inspiration and behind-the-scenes content</p>
    </div>
  </section>

</Layout>
