---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services | MAK Photos - Photography & Videography">

  <!-- PAGE HERO -->
  <section class="relative h-[60vh] min-h-[400px] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-dark/50 to-dark z-10"></div>
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1471341971476-ae15ff5dd4ea?w=1920&q=80')] bg-cover bg-center bg-fixed"></div>
    <div class="relative z-20 px-6 lg:px-12 pb-16 max-w-7xl mx-auto w-full">
      <span class="text-brand text-xs tracking-[0.3em] uppercase reveal">What We Do</span>
      <h1 class="font-heading text-5xl lg:text-7xl mt-4 reveal" style="transition-delay:0.2s">
        Our <span class="text-brand italic">Services</span>
      </h1>
    </div>
  </section>

  <!-- INTRO -->
  <section class="py-20 px-6 lg:px-12">
    <div class="max-w-3xl mx-auto text-center reveal">
      <p class="text-muted-text text-lg leading-relaxed">
        From the intimate details of a wedding day to the bold energy of a fashion editorial, MAK Photos delivers visual storytelling that resonates. Every project receives the same level of passion, creativity, and meticulous attention to detail.
      </p>
    </div>
  </section>

  <!-- SERVICES DETAIL -->
  <section class="px-6 lg:px-12 pb-24 lg:pb-40">
    <div class="max-w-7xl mx-auto space-y-0">

      {[
        {
          num: "01",
          title: "Wedding Photography & Videography",
          tagline: "Your Love Story, Beautifully Told",
          desc: "Your wedding day deserves to be remembered in all its glory. From the vibrant colors of the Mehndi to the emotional moments of the Nikkah, the grand entrance of the Barat, and the elegant Walima, we capture every chapter of your love story with artistry and emotion.",
          features: ["Full-day coverage (Mehndi to Walima)", "Cinematic wedding films", "Candid & posed photography", "Drone aerial coverage", "Same-day highlight reels", "Premium album design", "Engagement / Pre-wedding shoots", "Second shooter available"],
          img: "https://images.unsplash.com/photo-1519741497674-611481863552?w=800&q=80",
          imgAlt: "Wedding Photography by MAK Photos"
        },
        {
          num: "02",
          title: "Fashion & Editorial Photography",
          tagline: "Where Style Meets Vision",
          desc: "High-impact fashion photography that elevates your brand. Whether it's a full editorial spread, a seasonal lookbook, or social media content, we bring creative direction, expert lighting, and post-production excellence to every shoot.",
          features: ["Editorial & magazine shoots", "Lookbook & catalog photography", "E-commerce product photography", "Model portfolio shoots", "Brand campaign imagery", "Social media content creation", "Creative direction included", "Professional retouching"],
          img: "https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=800&q=80",
          imgAlt: "Fashion Photography by MAK Photos"
        },
        {
          num: "03",
          title: "Event Coverage",
          tagline: "Every Moment Matters",
          desc: "Comprehensive event photography and videography that captures the energy, emotion, and atmosphere of your occasion. From corporate conferences and product launches to concerts and cultural celebrations, we ensure nothing goes undocumented.",
          features: ["Corporate events & conferences", "Product launches", "Concerts & live performances", "Cultural & community events", "Award ceremonies", "Real-time social media delivery", "Multi-camera video coverage", "Quick turnaround editing"],
          img: "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&q=80",
          imgAlt: "Event Coverage by MAK Photos"
        },
        {
          num: "04",
          title: "Portrait Photography",
          tagline: "Reveal Your True Self",
          desc: "Whether you need professional headshots for your LinkedIn, a personal branding session, or a creative portrait shoot, we create images that reveal personality, confidence, and authenticity. Studio and outdoor options available throughout Lahore.",
          features: ["Professional headshots", "Personal branding sessions", "Creative portrait photography", "Family portrait sessions", "Graduation photography", "Studio & on-location options", "Professional hair & makeup referrals", "Digital & print delivery"],
          img: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600&q=80",
          imgAlt: "Portrait Photography by MAK Photos"
        },
        {
          num: "05",
          title: "Heritage & Architectural Photography",
          tagline: "Preserving History Through the Lens",
          desc: "As the official photographer at the Walled City of Lahore Authority, Moazzam brings a unique expertise in heritage documentation. From UNESCO World Heritage sites to contemporary architecture, we create visual records that honor the past and inspire the future.",
          features: ["Heritage site documentation", "Architectural photography", "Interior design photography", "Real estate photography", "Cultural preservation projects", "High-resolution archival quality", "Aerial / drone perspectives", "Exhibition-ready prints"],
          img: "https://images.unsplash.com/photo-1587474260584-136574528ed5?w=800&q=80",
          imgAlt: "Heritage Photography by MAK Photos"
        },
        {
          num: "06",
          title: "Cinematic Videography",
          tagline: "Stories in Motion",
          desc: "Beyond still photography, MAK Photos produces cinematic video content that brings your story to life with movement, music, and emotion. Our films are crafted with the same artistic vision and attention to detail as our photography.",
          features: ["Wedding highlight films", "Full ceremony documentation", "Corporate video production", "Brand promotional videos", "Social media video content", "Cinematic color grading", "Professional audio recording", "4K resolution output"],
          img: "https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=800&q=80",
          imgAlt: "Cinematic Videography by MAK Photos"
        },
      ].map((service, i) => (
        <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center py-20 ${i > 0 ? 'border-t border-dark-border' : ''}`}>
          <!-- Image -->
          <div class={`${i % 2 !== 0 ? 'lg:order-2' : ''} reveal-${i % 2 === 0 ? 'left' : 'right'}`}>
            <div class="relative">
              <div class="img-zoom aspect-[4/3] overflow-hidden">
                <img src={service.img} alt={service.imgAlt} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="absolute top-6 left-6 font-heading text-7xl text-brand/10">{service.num}</div>
            </div>
          </div>

          <!-- Content -->
          <div class={`${i % 2 !== 0 ? 'lg:order-1' : ''} reveal-${i % 2 === 0 ? 'right' : 'left'}`}>
            <span class="text-brand text-xs tracking-[0.3em] uppercase">{service.tagline}</span>
            <h2 class="font-heading text-3xl lg:text-4xl mt-3 mb-6">{service.title}</h2>
            <p class="text-muted-text leading-relaxed mb-8">{service.desc}</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
              {service.features.map(feature => (
                <div class="flex items-center gap-3 text-sm text-muted-text">
                  <svg class="w-4 h-4 text-brand flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  {feature}
                </div>
              ))}
            </div>

            <a href="/contact" class="group inline-flex items-center gap-3 text-brand text-sm tracking-[0.15em] uppercase hover:gap-5 transition-all duration-500">
              Book This Service
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-24 lg:py-40 px-6 lg:px-12 bg-dark-card">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20 reveal">
        <span class="text-brand text-xs tracking-[0.3em] uppercase">How We Work</span>
        <h2 class="font-heading text-4xl lg:text-5xl mt-4">Our <span class="text-brand italic">Process</span></h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
        {[
          { num: "01", title: "Consultation", desc: "We start with a conversation to understand your vision, needs, and expectations for the project." },
          { num: "02", title: "Planning", desc: "Detailed planning including location scouting, shot lists, timelines, and creative direction." },
          { num: "03", title: "The Shoot", desc: "Professional execution with attention to lighting, composition, and those spontaneous magical moments." },
          { num: "04", title: "Delivery", desc: "Expert editing, color grading, retouching, and delivery in your chosen format within the agreed timeline." },
        ].map(step => (
          <div class="text-center p-8 relative">
            <span class="font-heading text-6xl text-brand/15 block mb-4">{step.num}</span>
            <h3 class="font-heading text-xl mb-3">{step.title}</h3>
            <p class="text-sm text-muted-text leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-32 overflow-hidden">
    <div class="parallax-container absolute inset-0">
      <div class="parallax-bg bg-[url('https://images.unsplash.com/photo-1537633552985-df8429e8048b?w=1920&q=80')] bg-cover bg-center" data-speed="0.3"></div>
    </div>
    <div class="absolute inset-0 bg-dark/80"></div>
    <div class="relative z-10 text-center px-6">
      <div class="max-w-3xl mx-auto reveal">
        <span class="text-brand text-xs tracking-[0.3em] uppercase">Let's Get Started</span>
        <h2 class="font-heading text-4xl lg:text-6xl mt-6 mb-8">
          Have a Project in <span class="text-brand italic">Mind?</span>
        </h2>
        <p class="text-muted-text text-lg mb-10">
          Every project starts with a conversation. Tell us about your vision, and we'll craft a custom solution that exceeds your expectations.
        </p>
        <a href="/contact" class="group inline-flex items-center gap-3 px-10 py-5 bg-brand text-dark text-sm tracking-[0.15em] uppercase font-medium hover:bg-brand-light transition-all duration-500">
          Request a Quote
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>
