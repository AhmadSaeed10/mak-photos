---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | MAK Photos - Book a Session">

  <!-- PAGE HERO -->
  <section class="relative h-[50vh] min-h-[350px] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-dark/50 to-dark z-10"></div>
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1537633552985-df8429e8048b?w=1920&q=80')] bg-cover bg-center bg-fixed"></div>
    <div class="relative z-20 px-6 lg:px-12 pb-16 max-w-7xl mx-auto w-full">
      <span class="text-brand text-xs tracking-[0.3em] uppercase reveal">Get In Touch</span>
      <h1 class="font-heading text-5xl lg:text-7xl mt-4 reveal" style="transition-delay:0.2s">
        Contact <span class="text-brand italic">Us</span>
      </h1>
    </div>
  </section>

  <!-- CONTACT CONTENT -->
  <section class="py-24 lg:py-40 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-16 lg:gap-24">

      <!-- LEFT: Info -->
      <div class="lg:col-span-2 reveal-left">
        <span class="text-brand text-xs tracking-[0.3em] uppercase">Let's Talk</span>
        <h2 class="font-heading text-3xl lg:text-4xl mt-4 mb-6">Ready to Create Something <span class="text-brand italic">Beautiful?</span></h2>
        <p class="text-muted-text leading-relaxed mb-10">
          Whether you're planning a wedding, need professional portraits, or want to discuss a creative project, we'd love to hear from you. Fill out the form or reach out directly.
        </p>

        <!-- Contact Details -->
        <div class="space-y-8 mb-12">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 flex items-center justify-center bg-dark-card border border-dark-border flex-shrink-0">
              <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="font-medium text-sm mb-1">Location</h3>
              <p class="text-muted-text text-sm">Lahore, Pakistan</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 flex items-center justify-center bg-dark-card border border-dark-border flex-shrink-0">
              <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="font-medium text-sm mb-1">Email</h3>
              <a href="mailto:contact@makphotos.com" class="text-muted-text text-sm hover:text-brand transition-colors">contact@makphotos.com</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 flex items-center justify-center bg-dark-card border border-dark-border flex-shrink-0">
              <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <h3 class="font-medium text-sm mb-1">WhatsApp</h3>
              <a href="https://wa.me/923001234567" target="_blank" rel="noopener" class="text-muted-text text-sm hover:text-brand transition-colors">+92 300 123 4567</a>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div>
          <h3 class="font-medium text-sm mb-4">Follow Us</h3>
          <div class="flex gap-3">
            <a href="https://www.instagram.com/_makphotos/" target="_blank" rel="noopener" class="w-12 h-12 flex items-center justify-center bg-dark-card border border-dark-border hover:border-brand hover:text-brand text-muted-text transition-all duration-300">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
            <a href="https://www.facebook.com/" target="_blank" rel="noopener" class="w-12 h-12 flex items-center justify-center bg-dark-card border border-dark-border hover:border-brand hover:text-brand text-muted-text transition-all duration-300">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.instagram.com/i.moazzam.ali/" target="_blank" rel="noopener" class="w-12 h-12 flex items-center justify-center bg-dark-card border border-dark-border hover:border-brand hover:text-brand text-muted-text transition-all duration-300">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </a>
          </div>
        </div>

        <!-- Working Hours -->
        <div class="mt-10 p-6 bg-dark-card border border-dark-border">
          <h3 class="font-heading text-lg mb-4">Working Hours</h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between text-muted-text">
              <span>Monday - Friday</span>
              <span class="text-light-text">10:00 AM - 8:00 PM</span>
            </div>
            <div class="flex justify-between text-muted-text">
              <span>Saturday</span>
              <span class="text-light-text">11:00 AM - 6:00 PM</span>
            </div>
            <div class="flex justify-between text-muted-text">
              <span>Sunday</span>
              <span class="text-brand">By Appointment</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Form -->
      <div class="lg:col-span-3 reveal-right">
        <form id="contact-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs tracking-[0.2em] uppercase text-muted-text mb-2">Your Name *</label>
              <input type="text" id="name" name="name" required
                class="w-full bg-dark-card border border-dark-border px-4 py-3 text-light-text text-sm focus:border-brand focus:outline-none transition-colors placeholder:text-muted-text/50"
                placeholder="John Doe" />
            </div>
            <div>
              <label for="email" class="block text-xs tracking-[0.2em] uppercase text-muted-text mb-2">Email Address *</label>
              <input type="email" id="email" name="email" required
                class="w-full bg-dark-card border border-dark-border px-4 py-3 text-light-text text-sm focus:border-brand focus:outline-none transition-colors placeholder:text-muted-text/50"
                placeholder="john@example.com" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="phone" class="block text-xs tracking-[0.2em] uppercase text-muted-text mb-2">Phone / WhatsApp</label>
              <input type="tel" id="phone" name="phone"
                class="w-full bg-dark-card border border-dark-border px-4 py-3 text-light-text text-sm focus:border-brand focus:outline-none transition-colors placeholder:text-muted-text/50"
                placeholder="+92 300 000 0000" />
            </div>
            <div>
              <label for="service" class="block text-xs tracking-[0.2em] uppercase text-muted-text mb-2">Service Needed *</label>
              <select id="service" name="service" required
                class="w-full bg-dark-card border border-dark-border px-4 py-3 text-light-text text-sm focus:border-brand focus:outline-none transition-colors appearance-none">
                <option value="" disabled selected>Select a service</option>
                <option value="wedding">Wedding Photography</option>
                <option value="fashion">Fashion Photography</option>
                <option value="event">Event Coverage</option>
                <option value="portrait">Portrait Session</option>
                <option value="heritage">Heritage Documentation</option>
                <option value="video">Cinematic Videography</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>

          <div>
            <label for="date" class="block text-xs tracking-[0.2em] uppercase text-muted-text mb-2">Preferred Date</label>
            <input type="date" id="date" name="date"
              class="w-full bg-dark-card border border-dark-border px-4 py-3 text-light-text text-sm focus:border-brand focus:outline-none transition-colors" />
          </div>

          <div>
            <label for="budget" class="block text-xs tracking-[0.2em] uppercase text-muted-text mb-2">Budget Range</label>
            <select id="budget" name="budget"
              class="w-full bg-dark-card border border-dark-border px-4 py-3 text-light-text text-sm focus:border-brand focus:outline-none transition-colors appearance-none">
              <option value="" disabled selected>Select your budget</option>
              <option value="under-50k">Under PKR 50,000</option>
              <option value="50k-100k">PKR 50,000 - 100,000</option>
              <option value="100k-200k">PKR 100,000 - 200,000</option>
              <option value="200k-500k">PKR 200,000 - 500,000</option>
              <option value="above-500k">Above PKR 500,000</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs tracking-[0.2em] uppercase text-muted-text mb-2">Tell Us About Your Project *</label>
            <textarea id="message" name="message" rows="5" required
              class="w-full bg-dark-card border border-dark-border px-4 py-3 text-light-text text-sm focus:border-brand focus:outline-none transition-colors resize-none placeholder:text-muted-text/50"
              placeholder="Share details about your event, vision, and any specific requirements..."></textarea>
          </div>

          <button type="submit"
            class="group w-full sm:w-auto px-10 py-4 bg-brand text-dark text-sm tracking-[0.15em] uppercase font-medium hover:bg-brand-light transition-all duration-500 flex items-center justify-center gap-3">
            Send Message
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </button>
        </form>

        <!-- Form success message (hidden by default) -->
        <div id="form-success" class="hidden mt-8 p-8 bg-dark-card border border-brand/30 text-center">
          <svg class="w-12 h-12 text-brand mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <h3 class="font-heading text-xl mb-2">Message Sent!</h3>
          <p class="text-muted-text text-sm">Thank you for reaching out. We'll get back to you within 24 hours.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MAP AREA -->
  <section class="h-[400px] relative">
    <div class="absolute inset-0 bg-dark-card flex items-center justify-center">
      <div class="text-center">
        <svg class="w-12 h-12 text-brand/30 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <p class="font-heading text-2xl text-light-text/20">Lahore, Pakistan</p>
        <p class="text-muted-text/40 text-xs mt-2 tracking-wider uppercase">The Heart of Punjab</p>
      </div>
    </div>
    <!-- Replace with actual Google Maps embed when API key is available -->
  </section>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const success = document.getElementById('form-success');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      // In production, connect to a form service (Formspree, Netlify Forms, etc.)
      form.style.display = 'none';
      success?.classList.remove('hidden');
    });
  });
</script>
