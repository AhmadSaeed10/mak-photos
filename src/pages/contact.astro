---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactChannels from '../components/ContactChannels.astro';
import FaqList from '../components/FaqList.astro';
import { services } from '../data/services';
import { site, whatsappLink, instagramDmLink, messengerLink } from '../data/site';

const field = 'w-full bg-dark-card border border-dark-border px-4 py-3 text-light-text text-sm focus:border-brand focus:outline-none transition-colors placeholder:text-muted-text/50';
const label = 'block text-xs tracking-[0.2em] uppercase text-muted-text mb-2';
const faqs = [
  { q: 'Which channel gets the fastest reply?', a: 'WhatsApp. We usually reply within a few hours during working hours. Instagram and Messenger are checked daily.' },
  { q: 'Do I need to know my exact date?', a: "No. A month or season is enough to start. We'll hold a tentative date while you finalise plans." },
  { q: 'Can we meet in person?', a: 'Yes. Consultations in Lahore are available by appointment, or we can do a video call.' },
];
---
<Layout title="Contact | MAK Photos - Book a Session" description="Message MAK Photos on WhatsApp, Instagram or Messenger to check availability and book a shoot in Lahore.">
  <PageHero eyebrow="Get In Touch" title="Contact" accent="Us" image="https://images.unsplash.com/photo-1537633552985-df8429e8048b?w=1920&q=80" short />

  <section class="py-20 lg:py-28 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-12 reveal">
        <span class="text-brand text-xs tracking-[0.3em] uppercase">Message Us Directly</span>
        <h2 class="font-heading text-3xl lg:text-4xl mt-4">Pick the app you already <span class="text-brand italic">use</span></h2>
        <p class="text-muted-text mt-4">No forms to wait on. Tap a channel to start a conversation, or use the enquiry builder below to send all the details in one message.</p>
      </div>
      <div class="reveal"><ContactChannels /></div>
    </div>
  </section>

  <section class="pb-24 lg:pb-32 px-6 lg:px-12">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-16 lg:gap-20">
      <!-- Enquiry builder -->
      <div class="lg:col-span-3 reveal-left">
        <div class="p-6 sm:p-10 bg-dark-card border border-dark-border">
          <h2 class="font-heading text-2xl lg:text-3xl">Enquiry <span class="text-brand italic">builder</span></h2>
          <p class="text-muted-text text-sm mt-2 mb-8">Fill in what you know. We'll turn it into a ready-to-send message.</p>

          <form id="enquiry" class="space-y-6" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class={label}>Your Name *</label>
                <input type="text" id="name" name="name" required autocomplete="name" class={field} placeholder="Your full name" />
                <p class="field-error hidden text-xs text-red-400 mt-2" id="name-error">Please add your name.</p>
              </div>
              <div>
                <label for="service" class={label}>Service *</label>
                <select id="service" name="service" required class={`${field} appearance-none`}>
                  <option value="" disabled selected>Select a service</option>
                  {services.map((s) => <option value={s.shortTitle}>{s.shortTitle}</option>)}
                  <option value="Something else">Something else</option>
                </select>
                <p class="field-error hidden text-xs text-red-400 mt-2" id="service-error">Please choose a service.</p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="date" class={label}>Date or Month</label>
                <input type="text" id="date" name="date" class={field} placeholder="e.g. 14 Dec or February 2027" />
              </div>
              <div>
                <label for="location" class={label}>Location / Venue</label>
                <input type="text" id="location" name="location" class={field} placeholder="e.g. Lahore, venue name" />
              </div>
            </div>
            <div>
              <label for="budget" class={label}>Budget Range</label>
              <select id="budget" name="budget" class={`${field} appearance-none`}>
                <option value="">Prefer not to say</option>
                <option>Under PKR 50,000</option>
                <option>PKR 50,000 to 100,000</option>
                <option>PKR 100,000 to 200,000</option>
                <option>PKR 200,000 to 500,000</option>
                <option>Above PKR 500,000</option>
              </select>
            </div>
            <div>
              <label for="message" class={label}>Tell Us About It</label>
              <textarea id="message" name="message" rows="4" class={`${field} resize-none`} placeholder="Number of events, guest count, the look you love..."></textarea>
            </div>

            <fieldset>
              <legend class={label}>Send via</legend>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <button type="submit" data-channel="whatsapp" class="send-btn inline-flex items-center justify-center gap-2 px-5 py-4 bg-brand text-dark text-xs tracking-[0.15em] uppercase font-medium hover:bg-brand-light transition-all duration-300">WhatsApp</button>
                <button type="submit" data-channel="instagram" class="send-btn inline-flex items-center justify-center gap-2 px-5 py-4 border border-brand text-brand text-xs tracking-[0.15em] uppercase hover:bg-brand hover:text-dark transition-all duration-300">Instagram</button>
                <button type="submit" data-channel="messenger" class="send-btn inline-flex items-center justify-center gap-2 px-5 py-4 border border-brand text-brand text-xs tracking-[0.15em] uppercase hover:bg-brand hover:text-dark transition-all duration-300">Messenger</button>
              </div>
              <p class="text-xs text-muted-text mt-3">Instagram doesn't accept prefilled messages, so we copy yours to the clipboard. Just paste it into the chat.</p>
            </fieldset>
          </form>

          <div id="enquiry-done" class="hidden mt-8 p-6 border border-brand/40" role="status" aria-live="polite">
            <p class="font-heading text-lg">Your message is ready</p>
            <p class="text-sm text-muted-text mt-1" id="enquiry-done-text"></p>
            <pre id="enquiry-preview" class="mt-4 whitespace-pre-wrap text-xs text-muted-text bg-dark p-4 border border-dark-border font-body"></pre>
          </div>
        </div>
      </div>

      <!-- Info -->
      <aside class="lg:col-span-2 space-y-8 reveal-right">
        <div class="p-6 bg-dark-card border border-dark-border">
          <h3 class="font-heading text-lg mb-4">Working Hours</h3>
          <dl class="space-y-2 text-sm">
            <div class="flex justify-between text-muted-text"><dt>Monday to Friday</dt><dd class="text-light-text">10:00 AM to 8:00 PM</dd></div>
            <div class="flex justify-between text-muted-text"><dt>Saturday</dt><dd class="text-light-text">11:00 AM to 6:00 PM</dd></div>
            <div class="flex justify-between text-muted-text"><dt>Sunday</dt><dd class="text-brand">By appointment</dd></div>
          </dl>
          <p class="text-xs text-muted-text mt-4">Event days run on your schedule, of course.</p>
        </div>
        <div class="p-6 bg-dark-card border border-dark-border">
          <h3 class="font-heading text-lg mb-2">Based in {site.city}</h3>
          <p class="text-sm text-muted-text">Available across Pakistan. Travel outside Lahore is quoted separately.</p>
        </div>
        <div>
          <h3 class="font-heading text-lg mb-4">Quick answers</h3>
          <FaqList faqs={faqs} />
        </div>
      </aside>
    </div>
  </section>

  <section class="h-[420px] relative border-t border-dark-border">
    <iframe
      title={`Map of ${site.mapQuery}`}
      src={`https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&z=12&output=embed`}
      class="absolute inset-0 w-full h-full [filter:grayscale(1)_invert(0.92)_contrast(0.9)]"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</Layout>

<script define:vars={{ wa: whatsappLink(), ig: instagramDmLink, fb: messengerLink() }}>
  const form = document.getElementById('enquiry');
  const done = document.getElementById('enquiry-done');
  const doneText = document.getElementById('enquiry-done-text');
  const preview = document.getElementById('enquiry-preview');
  let channel = 'whatsapp';

  form.querySelectorAll('.send-btn').forEach((b) => b.addEventListener('click', () => (channel = b.dataset.channel)));

  const validate = (id) => {
    const el = form.elements.namedItem(id);
    const err = document.getElementById(`${id}-error`);
    const ok = !!el.value.trim();
    el.setAttribute('aria-invalid', String(!ok));
    if (err) { err.classList.toggle('hidden', ok); el.setAttribute('aria-describedby', `${id}-error`); }
    el.classList.toggle('border-red-400', !ok);
    return ok;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const okName = validate('name');
    const okService = validate('service');
    if (!okName || !okService) {
      form.querySelector('[aria-invalid="true"]')?.focus();
      return;
    }
    const v = (n) => form.elements.namedItem(n).value.trim();
    const lines = [
      `Hi MAK Photos, I'm ${v('name')}.`,
      `I'm interested in: ${v('service')}`,
      v('date') && `Date: ${v('date')}`,
      v('location') && `Location: ${v('location')}`,
      v('budget') && `Budget: ${v('budget')}`,
      v('message') && `\n${v('message')}`,
    ].filter(Boolean);
    const text = lines.join('\n');

    let copied = false;
    try { await navigator.clipboard.writeText(text); copied = true; } catch {}

    const sep = (u) => (u.includes('?') ? '&' : '?');
    const url =
      channel === 'whatsapp' ? `${wa}${sep(wa)}text=${encodeURIComponent(text)}` :
      channel === 'messenger' ? `${fb}${sep(fb)}text=${encodeURIComponent(text)}` : ig;
    window.open(url, '_blank', 'noopener');

    const name = { whatsapp: 'WhatsApp', instagram: 'Instagram', messenger: 'Messenger' }[channel];
    preview.textContent = text;
    doneText.textContent = channel === 'whatsapp'
      ? `We opened ${name} with your message filled in. Just tap send.`
      : copied
        ? `We opened ${name} and copied your message. Paste it into the chat and send.`
        : `We opened ${name}. Copy the message below and paste it into the chat.`;
    done.classList.remove('hidden');
  });

  ['name', 'service'].forEach((id) => form.elements.namedItem(id).addEventListener('change', () => validate(id)));
</script>
