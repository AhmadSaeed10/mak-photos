---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';

const process = [
  { num: '01', title: 'Consultation', desc: 'A quick call or chat to understand your vision, dates, budget and must-have moments.' },
  { num: '02', title: 'Planning', desc: 'Location scouting, shot lists, timelines and creative direction, shared with you in writing.' },
  { num: '03', title: 'The Shoot', desc: 'Calm, professional execution with an eye for light, composition and spontaneous moments.' },
  { num: '04', title: 'Delivery', desc: 'Editing, color grading and retouching, delivered through a private gallery on an agreed timeline.' },
];
---
<Layout title="Services | MAK Photos - Photography & Videography in Lahore" description="Wedding, fashion, event, portrait, heritage photography and cinematic videography by MAK Photos in Lahore.">
  <PageHero eyebrow="What We Do" title="Our" accent="Services" image="https://images.unsplash.com/photo-1471341971476-ae15ff5dd4ea?w=1920&q=80" />

  <section class="py-20 px-6 lg:px-12">
    <div class="max-w-3xl mx-auto text-center reveal">
      <p class="text-muted-text text-lg leading-relaxed">
        From the intimate details of a wedding day to the bold energy of a fashion editorial, MAK Photos delivers visual storytelling that resonates. Choose a service to see what's included, how it works and answers to common questions.
      </p>
      <a href="/packages" class="inline-flex items-center gap-3 mt-8 text-brand text-sm tracking-[0.15em] uppercase hover:gap-5 transition-all duration-500">
        Compare packages & pricing
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

  <!-- Quick jump -->
  <section class="px-6 lg:px-12 pb-8">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 stagger-children">
      {services.map((s) => (
        <a href={`/services/${s.slug}`} class="group p-5 bg-dark-card border border-dark-border hover:border-brand transition-all duration-300 text-center">
          <div class="text-brand flex justify-center mb-3" set:html={s.icon} />
          <span class="text-xs tracking-[0.15em] uppercase text-muted-text group-hover:text-light-text transition-colors">{s.shortTitle}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="px-6 lg:px-12 pb-24 lg:pb-40">
    <div class="max-w-7xl mx-auto">
      {services.map((service, i) => (
        <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center py-20 ${i > 0 ? 'border-t border-dark-border' : ''}`}>
          <div class={`${i % 2 !== 0 ? 'lg:order-2' : ''} reveal-${i % 2 === 0 ? 'left' : 'right'}`}>
            <a href={`/services/${service.slug}`} class="relative block" tabindex="-1" aria-hidden="true">
              <div class="img-zoom aspect-[4/3] overflow-hidden">
                <img src={service.img} alt="" class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="absolute top-6 left-6 font-heading text-7xl text-brand/10">{service.num}</div>
            </a>
          </div>
          <div class={`${i % 2 !== 0 ? 'lg:order-1' : ''} reveal-${i % 2 === 0 ? 'right' : 'left'}`}>
            <span class="text-brand text-xs tracking-[0.3em] uppercase">{service.tagline}</span>
            <h2 class="font-heading text-3xl lg:text-4xl mt-3 mb-6"><a href={`/services/${service.slug}`} class="hover:text-brand transition-colors">{service.title}</a></h2>
            <p class="text-muted-text leading-relaxed mb-8">{service.desc}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
              {service.features.slice(0, 6).map((feature) => (
                <div class="flex items-center gap-3 text-sm text-muted-text">
                  <svg class="w-4 h-4 text-brand flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  {feature}
                </div>
              ))}
            </div>
            <div class="flex flex-wrap items-center gap-6">
              <a href={`/services/${service.slug}`} class="group inline-flex items-center gap-3 px-6 py-3 border border-brand text-brand text-xs tracking-[0.2em] uppercase hover:bg-brand hover:text-dark transition-all duration-500">
                Explore {service.shortTitle}
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-24 lg:py-40 px-6 lg:px-12 bg-dark-card">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20 reveal">
        <span class="text-brand text-xs tracking-[0.3em] uppercase">How We Work</span>
        <h2 class="font-heading text-4xl lg:text-5xl mt-4">Our <span class="text-brand italic">Process</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
        {process.map((step) => (
          <div class="text-center p-8">
            <span class="font-heading text-6xl text-brand/15 block mb-4">{step.num}</span>
            <h3 class="font-heading text-xl mb-3">{step.title}</h3>
            <p class="text-sm text-muted-text leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
